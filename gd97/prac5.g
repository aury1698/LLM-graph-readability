NSTYL "normal" [  NS 32 32 NTI 2 NFI 3 NLP 0 NEI 4 NLV 1 COL 1 NP 0 0 ]
NSTYL "gragra left side" [  NS 128 128 NTI 0 NFI 7 NLP 1 NEI 4 NLV 1 COL 10 NP 0 0 ]
NSTYL "gragra embed node" [  NS 32 32 NTI 2 NFI 7 NLP 0 NEI 1 NLV 1 COL 12 NP 0 0 ]
ESTYL "normal" [  ETI 0 EFI 5 ELV 1 AL 8 AA 45 COL 3 ]
ESTYL "gragra embed edge" [  ETI 2 EFI 7 ELV 1 AL 8 AA 45 COL 9 ]
DIR 1
GRAGRA 3 "[a-z_$]*""[A-Z][a-zA-Z_$]*" GEMBED "embedding" EMBMATCH 0
ELS 256 64

;
WA 4000 4000
WAWIN 0 0 796 592
SC 1673 1841
GR 32
